# Graph API Explorer 또는 앱에서 발급받은 Threads 액세스 토큰
# 필요한 권한: threads_basic, threads_keyword_search
THREADS_ACCESS_TOKEN=your_token_here

# 장기 토큰 교환/갱신에 필요. 토큰을 발급한 "그 앱"의 시크릿이어야 함.
# Meta 앱 대시보드 > 앱 설정 > 기본 설정 > 앱 시크릿
THREADS_APP_SECRET=your_app_secret_here

# 인스타그램 본인 계정 게시글/인사이트 조회용 토큰
# 프로페셔널(비즈니스/크리에이터) 계정 + 권한: instagram_business_basic, instagram_business_manage_insights
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here

# 인스타 장기 토큰 교환/갱신용. "인스타그램 앱 시크릿" (페이스북 앱 시크릿과 다를 수 있음)
# Meta 앱 > Instagram > API setup with Instagram login > Instagram app secret
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here

# === 구글 시트 자동 동기화 ===
# 1) Google Cloud > Sheets API 사용설정 > 서비스계정 생성 > JSON 키 다운로드한 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# 2) 시트 URL의 /d/ 와 /edit 사이 문자열
GSHEET_ID=your_spreadsheet_id_here
# 3) 기록할 탭 이름 (없으면 "인스타")
GSHEET_TAB=인스타
# ⚠️ service-account.json 안의 client_email 을 해당 시트에 "편집자"로 공유해야 함
